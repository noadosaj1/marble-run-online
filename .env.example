# ---- Server (read from process env) ----
PORT=3001
# Comma-separated list of allowed browser origins, or * for any.
CLIENT_ORIGIN=*
# Serve the built client (dist/) from this server too (single-host deploy).
SERVE_CLIENT=true
MAX_PLAYERS=16
COUNTDOWN_MS=3500
ROOM_EMPTY_TTL_MS=30000
RECONNECT_GRACE_MS=10000

# ---- Client (build time, Vite) ----
# URL of the game server. Leave empty to use the same origin as the page
# (or http://<page-host>:3001 when running `npm run dev`).
VITE_SERVER_URL=
